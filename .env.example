# Synth.is backend services the composing app talks to.
# For a standard LOCAL stack the baked-in defaults below work with NO .env at all
# (`npm run dev`). To run locally against the LIVE services use `npm start`, which
# loads .env.production-local (committed). Copy this file to .env for a custom local
# setup (.env is git-ignored).

# kromosynth-recommend: sound listings, preview WAVs, and /api/user/sequences
VITE_RECOMMEND_SERVICE_URL=http://localhost:3004

# kromosynth-auth: /api/auth/login (only needed for the garden + saving)
VITE_AUTH_SERVICE_URL=http://127.0.0.1:3002

# evoruns service: static server for CLI-pre-rendered WAVs (MIDI params, corpus
# sounds). Not used by default playback — on-demand renders go via the preview WS below.
VITE_EVORUNS_SERVICE_URL=http://localhost:3010

# Preview render WebSocket: renders a genome on demand (custom duration/pitch/velocity)
# so custom per-sound settings are audible in Strudel. Dev: ws://localhost:3000
VITE_PREVIEW_WS_URL=ws://localhost:3000

# Main Synth.is web app, for the “← Synth.is” back link. Dev: http://localhost:5173
VITE_SYNTHIS_APP_URL=http://localhost:5173
